"""Build a governed monthly PDF/XLSX report from Phase 3 outputs and DuckDB."""
from __future__ import annotations
import argparse, os
from pathlib import Path
from datetime import date, datetime
import pandas as pd
import duckdb
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.chart import LineChart, BarChart, Reference
from reportlab.lib import colors
from reportlab.lib.enums import TA_CENTER
from reportlab.lib.pagesizes import A4, landscape
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.units import mm
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, PageBreak, KeepTogether

ROOT = Path(__file__).resolve().parent
PHASE3 = ROOT.parent / "phase-3"
DB = Path(os.getenv("PULSEIQ_DB_PATH", PHASE3 / "outputs" / "pulseiq.duckdb"))
OUT = ROOT / "reports"

def _csv(name: str) -> pd.DataFrame:
    path = DB.parent / name
    if not path.exists():
        return pd.DataFrame()
    df = pd.read_csv(path)
    if "period" in df.columns:
        df["period"] = pd.to_datetime(df["period"], errors="coerce")
    return df

def load_data(start: str, end: str, cutoff: str | None):
    if not DB.exists():
        raise FileNotFoundError(f"DuckDB warehouse not found: {DB}. Set PULSEIQ_DB_PATH or restore phase-3/outputs/pulseiq.duckdb.")
    con = duckdb.connect(str(DB), read_only=True)
    try:
        tables = {r[0] for r in con.execute("SHOW TABLES").fetchall()}
        if not {"all_metrics", "metric_catalog"}.issubset(tables):
            raise RuntimeError("Phase 3 governed views all_metrics and metric_catalog are required. Run the Phase 3 refresh first.")
        metrics = con.execute("""
            SELECT m.metric_id, m.metric_name, CAST(m.period AS DATE) AS period,
                   m.department_id, m.value, m.unit, m.min_group_size, m.caveat,
                   c.business_definition, c.formula, c.source_table, c.good_direction
            FROM all_metrics m JOIN metric_catalog c USING(metric_id)
            WHERE m.metric_id IN ('M16','M17','M18','M21','M22')
              AND CAST(m.period AS DATE) BETWEEN ? AND ?
            ORDER BY m.metric_id, m.period
        """, [start, end]).fetchdf()
    finally:
        con.close()
    metrics["period"] = pd.to_datetime(metrics["period"], errors="coerce")
    if cutoff:
        metrics = metrics[metrics["period"] <= pd.Timestamp(cutoff)]
    outputs = {
        "Profit and loss": _csv("phase3_day11_pnl_monthly.csv"),
        "Expense categories": _csv("phase3_day11_expense_categories.csv"),
        "Cash flow": _csv("phase3_day12_cash_flow_monthly.csv"),
        "Receivables ageing": _csv("phase3_day12_receivables_ageing.csv"),
        "Anomaly signals": _csv("phase3_day14_anomalies_by_type.csv"),
        "Forecast validation": _csv("phase3_day14_forecast_validation_summary.csv"),
        "Workforce cost": _csv("phase3_day13_workforce_cost_monthly.csv"),
        "Day 13 reconciliation": _csv("phase3_day13_reconciliation.csv"),
    }
    for name, df in list(outputs.items()):
        if "period" in df.columns:
            outputs[name] = df[(df["period"] >= pd.Timestamp(start)) & (df["period"] <= pd.Timestamp(end))]
            if cutoff:
                outputs[name] = outputs[name][outputs[name]["period"] <= pd.Timestamp(cutoff)]
    if metrics.empty:
        raise RuntimeError("No governed KPI rows were found in the selected period.")
    effective_cutoff = cutoff or end
    return metrics, outputs, effective_cutoff

def _fmt(v):
    if pd.isna(v): return "Not available"
    if isinstance(v, (float, int)): return f"{v:,.2f}"
    if isinstance(v, (pd.Timestamp, datetime)): return v.strftime("%Y-%m")
    return str(v)

def make_xlsx(metrics, outputs, start, end, cutoff, path):
    wb = Workbook()
    ws = wb.active; ws.title = "KPI Summary"
    ws.append(["PulseIQ Monthly Report"])
    ws.append(["Reporting period", start, "to", end])
    ws.append(["Data cutoff", cutoff])
    ws.append(["Source", "Phase 3 governed DuckDB metric views and derived output tables"])
    ws.append([])
    ws.append(["Metric ID","Metric","Period","Department","Value","Unit","Definition","Source","Caveat"])
    for _, r in metrics.iterrows():
        ws.append([r.metric_id,r.metric_name, r.period.strftime("%Y-%m-%d") if pd.notna(r.period) else None,
                   r.department_id, None if pd.isna(r.value) else float(r.value), r.unit,
                   r.business_definition, r.source_table, r.caveat])
    for cell in ws[1]:
        cell.font = Font(bold=True, size=16, color="FFFFFF"); cell.fill = PatternFill("solid", fgColor="17365D")
    for cell in ws[6]:
        cell.font = Font(bold=True, color="FFFFFF"); cell.fill = PatternFill("solid", fgColor="1F4E78")
    ws.freeze_panes = "A7"; ws.auto_filter.ref = ws.dimensions
    for col, width in {"A":13,"B":30,"C":14,"D":18,"E":18,"F":18,"G":55,"H":32,"I":48}.items(): ws.column_dimensions[col].width=width
    for name, df in outputs.items():
        if df.empty: continue
        sheet = name[:31]
        sh=wb.create_sheet(sheet)
        sh.append(list(df.columns))
        for row in df.itertuples(index=False, name=None):
            sh.append([None if pd.isna(v) else (v.to_pydatetime() if isinstance(v,pd.Timestamp) else v) for v in row])
        for c in sh[1]:
            c.font=Font(bold=True,color="FFFFFF"); c.fill=PatternFill("solid",fgColor="1F4E78")
        sh.freeze_panes="A2"; sh.auto_filter.ref=sh.dimensions
        for col in sh.columns:
            letter=col[0].column_letter
            sh.column_dimensions[letter].width=min(34,max(13,max(len(str(c.value or "")) for c in col[:100])+2))
        numeric_cols=[i+1 for i,c in enumerate(df.columns) if pd.api.types.is_numeric_dtype(df[c])]
        if numeric_cols and len(df)>0:
            chart=LineChart() if "period" in df.columns else BarChart()
            chart.title=f"{name} trend" if "period" in df.columns else name
            category_name = next((c for c in ("period","expense_category","ageing_bucket","anomaly_type") if c in df.columns), df.columns[0])
            category_col = list(df.columns).index(category_name) + 1
            chart.y_axis.title="Value"; chart.x_axis.title=category_name.replace("_"," ").title()
            for idx in numeric_cols[:3]:
                chart.add_data(Reference(sh,min_col=idx,min_row=1,max_row=len(df)+1),titles_from_data=True)
            chart.set_categories(Reference(sh,min_col=category_col,min_row=2,max_row=len(df)+1))
            chart.height=7; chart.width=14
            sh.add_chart(chart,"K2")
    wb.save(path)

def make_pdf(metrics, outputs, start, end, cutoff, path):
    styles=getSampleStyleSheet()
    styles.add(ParagraphStyle(name="Small", parent=styles["BodyText"], fontSize=7, leading=9))
    doc=SimpleDocTemplate(str(path),pagesize=landscape(A4),rightMargin=12*mm,leftMargin=12*mm,topMargin=12*mm,bottomMargin=12*mm)
    story=[Paragraph("PulseIQ | Monthly Business Report",styles["Title"]),
           Paragraph(f"Reporting period: {start} to {end} | Data cutoff: {cutoff}",styles["Heading2"]),
           Paragraph("Source: Phase 3 governed DuckDB metric views and derived Phase 3 output tables. Values are reported as supplied; unavailable values are not treated as zero.",styles["Small"]),Spacer(1,5*mm)]
    # Summary: latest available value per KPI, company-level rows only when department_id is null.
    summary=metrics[metrics["department_id"].isna()].copy()
    if summary.empty: summary=metrics.copy()
    latest=summary.sort_values("period").groupby(["metric_id","metric_name"],as_index=False).tail(1)
    rows=[["Metric","Latest period","Value","Unit","Definition"]]
    for _,r in latest.iterrows(): rows.append([r.metric_name,_fmt(r.period),_fmt(r.value),r.unit,str(r.business_definition)[:115]])
    t=Table(rows,repeatRows=1,colWidths=[40*mm,24*mm,28*mm,25*mm,145*mm])
    t.setStyle(TableStyle([("BACKGROUND",(0,0),(-1,0),colors.HexColor("#17365D")),("TEXTCOLOR",(0,0),(-1,0),colors.white),("FONTNAME",(0,0),(-1,0),"Helvetica-Bold"),("FONTSIZE",(0,0),(-1,-1),7),("GRID",(0,0),(-1,-1),.3,colors.grey),("VALIGN",(0,0),(-1,-1),"TOP"),("ROWBACKGROUNDS",(0,1),(-1,-1),[colors.white,colors.HexColor("#EAF0F6")])]))
    story += [Paragraph("Executive KPI snapshot",styles["Heading1"]),t,Spacer(1,5*mm)]
    sections=[
      ("Profit and loss",["period","operating_revenue","other_income","total_income","expenses","net_profit","net_margin_pct"]),
      ("Expense categories",["period","expense_category","expense_amount"]),
      ("Cash flow",["period","cash_in","cash_out","net_cash_flow"]),
      ("Receivables ageing",["ageing_bucket","invoice_count","receivables_amount"]),
      ("Anomaly signals",["anomaly_type","records_scored","flagged_count","money_at_risk"]),
    ]
    for title,cols in sections:
        df=outputs.get(title,pd.DataFrame())
        story.append(Paragraph(title,styles["Heading1"]))
        if df.empty:
            story.append(Paragraph("No rows available for this period in the packaged Phase 3 outputs.",styles["Small"]))
            continue
        df=df[[c for c in cols if c in df.columns]].head(30)
        data=[[str(c).replace("_"," ").title() for c in df.columns]]
        data += [[_fmt(v) for v in row] for row in df.itertuples(index=False,name=None)]
        widths=[(landscape(A4)[0]-24*mm)/max(1,len(df.columns))]*len(df.columns)
        tb=Table(data,repeatRows=1,colWidths=widths)
        tb.setStyle(TableStyle([("BACKGROUND",(0,0),(-1,0),colors.HexColor("#1F4E78")),("TEXTCOLOR",(0,0),(-1,0),colors.white),("FONTNAME",(0,0),(-1,0),"Helvetica-Bold"),("FONTSIZE",(0,0),(-1,-1),7),("GRID",(0,0),(-1,-1),.3,colors.grey),("ROWBACKGROUNDS",(0,1),(-1,-1),[colors.white,colors.HexColor("#EAF0F6")])]))
        story += [tb,Spacer(1,4*mm)]
    story += [Paragraph("Interpretation and limitations",styles["Heading1"]),
              Paragraph("Anomaly flags are investigation signals, not proof of fraud or realized loss. Forecast accuracy is not measurable until actuals exist for the forecast periods. Reconciliation and data-quality exceptions must be reviewed before external distribution. Department-level values remain subject to the governed metric suppression rules.",styles["BodyText"])]
    doc.build(story)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--start",required=True,help="Inclusive ISO date, e.g. 2025-04-01")
    ap.add_argument("--end",required=True,help="Inclusive ISO date, e.g. 2026-09-30")
    ap.add_argument("--cutoff",help="Optional ISO data cutoff")
    ap.add_argument("--format",choices=["pdf","xlsx","both"],default="both")
    args=ap.parse_args()
    start=date.fromisoformat(args.start); end=date.fromisoformat(args.end)
    if start>end: ap.error("--start must be on or before --end")
    metrics,outputs,cutoff=load_data(start.isoformat(),end.isoformat(),args.cutoff)
    OUT.mkdir(parents=True,exist_ok=True)
    stem=f"pulseiq_monthly_{start:%Y%m%d}_{end:%Y%m%d}"
    if args.format in ("xlsx","both"):
        path=OUT/f"{stem}.xlsx"; make_xlsx(metrics,outputs,start.isoformat(),end.isoformat(),cutoff,path); print(path)
    if args.format in ("pdf","both"):
        path=OUT/f"{stem}.pdf"; make_pdf(metrics,outputs,start.isoformat(),end.isoformat(),cutoff,path); print(path)
if __name__=="__main__": main()
